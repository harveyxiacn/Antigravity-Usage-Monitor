{
  "name": "antigravity-usage-monitor",
  "version": "1.4.2",
  "description": "Local quota monitor, next-refresh remaining percentage forecaster, and token analytics for Google Antigravity (MCP App + Plugin + Hook + CLI).",
  "license": "MIT",
  "author": "harveyxiacn",
  "repository": {
    "type": "git",
    "url": "https://github.com/harveyxiacn/Antigravity-Usage-Monitor.git"
  },
  "homepage": "https://github.com/harveyxiacn/Antigravity-Usage-Monitor",
  "type": "module",
  "bin": {
    "agy-usage": "./dist/cli/index.js",
    "agy-usage-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "build:bundle": "node scripts/build-bundles.mjs",
    "build": "npm run build:ts && npm run build:ui && npm run build:bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "install-plugin": "node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
